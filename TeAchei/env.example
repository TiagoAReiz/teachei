# ===========================================
# TeAchei Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Database Configuration (PostgreSQL)
POSTGRES_DB=teachei
POSTGRES_USER=teachei
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Server
SERVER_PORT=8080

# Azure Cosmos DB Configuration
# For local development with Docker Compose emulator:
COSMOS_ENDPOINT=https://localhost:8081
# Well-known emulator key (safe for local dev, do not use in production):
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=teachei
COSMOS_POPULATE_QUERY_METRICS=false
# For production, use your Azure Cosmos DB account:
# COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
# COSMOS_KEY=your_cosmos_primary_key_here

# Azure Blob Storage / Azurite (local)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_PROFILE_PHOTOS_CONTAINER=profile-photos
AZURE_STORAGE_VEHICLE_PHOTOS_CONTAINER=vehicle-photos

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRATION_HOURS=1

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=your_access_token_here
MERCADOPAGO_PUBLIC_KEY=your_public_key_here
MERCADOPAGO_WEBHOOK_SECRET=
# Use TEST- prefix for sandbox tokens
# Get webhook secret from: https://www.mercadopago.com.br/developers/panel/app → Webhooks

# FIPE API Configuration
FIPE_API_BASE_URL=https://parallelum.com.br/fipe/api/v1

# Application Configuration
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Admin
APP_ADMIN_SECRET=

# Payment Configuration
PAYMENT_PRICE_PER_AD=29.90
INTENTION_EXPIRY_DAYS=60

# Subscription Plans (prices in centavos)
SUBSCRIPTION_INDIVIDUAL_PRICE=200
SUBSCRIPTION_QUARTERLY_PRICE=3000
SUBSCRIPTION_ANNUAL_PRICE=9000

# Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev


