generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  // Conexão direta (sem PgBouncer), usada por `prisma db push`/migrate.
  // O pooler em modo transação (porta 6543) não suporta essas operações.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Usuario {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  senhaHash     String?    @map("senha_hash")
  googleId      String?    @unique @map("google_id")
  aceitouTermos Boolean    @default(false) @map("aceitou_termos")
  criadoEm     DateTime   @default(now()) @map("criado_em")
  perfil        Perfil?
  anuncios      Anuncio[]
  favoritos     Favorito[]
  vendasFeitas  Venda[]     @relation("VendedorVenda")
  comprasFeitas Venda[]     @relation("CompradorVenda")
  avaliacoesFeitas    Avaliacao[] @relation("AvaliadorAvaliacao")
  avaliacoesRecebidas Avaliacao[] @relation("AvaliadoAvaliacao")

  @@map("usuarios")
}

model Perfil {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @unique @map("usuario_id") @db.Uuid
  nome      String
  bio       String?
  fotoUrl   String?  @map("foto_url")
  whatsapp  String?
  instagram String?
  facebook  String?
  cidade    String?
  estado    String?
  role      String   @default("BUYER")
  criadoEm DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfis")
}

model Anuncio {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String     @map("usuario_id") @db.Uuid
  tipo        String
  status      String     @default("ATIVO")
  veiculo     Json
  contato     Json
  observacoes String?
  criadoEm   DateTime   @default(now()) @map("criado_em")
  expiraEm   DateTime?  @map("expira_em")
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  favoritos   Favorito[]
  vendas      Venda[]

  @@map("anuncios")
}

model Favorito {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  anuncioId String   @map("anuncio_id") @db.Uuid
  criadoEm DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, anuncioId])
  @@map("favoritos")
}

model Opcional {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo String   @unique
  label  String
  tipos  String[] // vazio = todos os tipos; ex: ["CARRO", "CAMINHAO"]
  ativo  Boolean  @default(true)
  ordem  Int      @default(0)

  @@map("opcionais")
}

model Venda {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anuncioId   String?    @map("anuncio_id") @db.Uuid
  vendedorId  String     @map("vendedor_id") @db.Uuid
  compradorId String     @map("comprador_id") @db.Uuid
  criadoEm    DateTime   @default(now()) @map("criado_em")
  anuncio     Anuncio?   @relation(fields: [anuncioId], references: [id], onDelete: SetNull)
  vendedor    Usuario    @relation("VendedorVenda", fields: [vendedorId], references: [id], onDelete: Cascade)
  comprador   Usuario    @relation("CompradorVenda", fields: [compradorId], references: [id], onDelete: Cascade)
  avaliacao   Avaliacao?

  @@unique([anuncioId, vendedorId])
  @@map("vendas")
}

model Avaliacao {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendaId     String   @unique @map("venda_id") @db.Uuid
  avaliadorId String   @map("avaliador_id") @db.Uuid
  avaliadoId  String   @map("avaliado_id") @db.Uuid
  nota        Int      @db.SmallInt
  comentario  String?
  criadoEm    DateTime @default(now()) @map("criado_em")
  venda       Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  avaliador   Usuario  @relation("AvaliadorAvaliacao", fields: [avaliadorId], references: [id], onDelete: Cascade)
  avaliado    Usuario  @relation("AvaliadoAvaliacao", fields: [avaliadoId], references: [id], onDelete: Cascade)

  @@map("avaliacoes")
}
