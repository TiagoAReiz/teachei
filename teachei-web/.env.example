# Banco de dados (Supabase Postgres) — usado pelo Prisma (prisma/schema.prisma)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase (server-side, backend/shared/db/supabase.ts)
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# JWT (backend/shared/middleware/jwt.ts) — mínimo de 32 caracteres
JWT_SECRET=""

# Google OAuth (client-side, app/providers.tsx)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# URLs públicas (config/env.ts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Deixe vazio para usar as API Routes do próprio Next.js
NEXT_PUBLIC_API_URL=""
